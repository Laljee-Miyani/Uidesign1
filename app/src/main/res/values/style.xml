<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="style_button_default" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/vector_button_default</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/tv_secondary</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="style_tv_primary" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/tv_primary</item>
    </style>

    <style name="style_tv_semi_primary" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/text_Color_Primary</item>
        <item name="android:textSize">@dimen/h3</item>
    </style>

    <style name="style_tv_before_et" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/tv_before_et</item>
        <item name="android:textSize">@dimen/tv_secondary</item>
    </style>

    <style name="style_tv_default" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/lightGrey</item>
        <item name="android:textSize">@dimen/tv_secondary</item>
    </style>

    <style name="style_tv_search">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text_Color_Primary</item>
        <item name="android:textSize">@dimen/tv_search</item>
        <item name="hintTextColor">@color/tv_search</item>
    </style>

    <style name="style_search_history" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textCursorDrawable">@drawable/vector_cursor</item>
    </style>

    <style name="style_dot_indicator" parent="ScrollingPagerIndicator">
        <item name="spi_dotColor">@color/unselected_Dot</item>
        <item name="spi_dotSelectedColor">@color/selected_Dot</item>
        <item name="spi_dotSpacing">8dp</item>
        <item name="spi_dotSize">8dp</item>
    </style>

    <style name="style_tv_list" parent="Widget.AppCompat.TextView">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">@dimen/tv_list</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
    </style>

    <style name="style_checkout_tv">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/checkout_step</item>
        <item name="android:textSize">@dimen/tv_checkout_step</item>
    </style>

    <style name="style_counter" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/vector_chat_counter</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="style_radio_button" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@drawable/selector_radio_button</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="buttonTint">@color/selector_radio_button</item>
    </style>

    <style name="style_Subscription_tv_plan" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_list</item>
    </style>

    <style name="style_subscription_tv_price" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/h3</item>
    </style>

    <style name="style_Subscription_tv_plan_time" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_subscription_plan_time</item>
    </style>

    <style name="style_Subscription_tv_discount" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">@dimen/tv_subscription_plan_time</item>
    </style>

    <style name="style_interests_tv" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/tv_List</item>
        <item name="android:textSize">@dimen/tv_list</item>
    </style>

    <style name="style_card_details_tv" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_list</item>
    </style>

    <style name="style_et" parent="Widget.AppCompat.EditText">
        <item name="background">@drawable/vector_et_unselected</item>
        <item name="android:textColorHint">@color/et_Hint_Color</item>
        <item name="android:textSize">@dimen/et_text_size</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text_Color_Primary</item>
        <item name="android:textCursorDrawable">@drawable/vector_cursor</item>
    </style>

    <style name="style_et_password" parent="Widget.AppCompat.EditText">
        <item name="cornerSize">12dp</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">12dp</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="Style_tv_clickable" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">@dimen/tv_forgot_password</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="style_tv_InputLayout_pwd" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">none</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="endIconTint">@color/et_Hint_Color</item>
        <item name="android:textCursorDrawable">@drawable/vector_cursor</item>
    </style>

    <style name="style_otp_et" parent="Widget.AppCompat.EditText">
        <item name="android:inputType">numberDecimal</item>
        <item name="android:maxLength">1</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/text_Color_Primary</item>
        <item name="android:textCursorDrawable">@drawable/vector_cursor</item>
    </style>

    <style name="style_tab_text" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CustomRatingBar" parent="@android:style/Widget.DeviceDefault.RatingBar">
        <item name="android:progressDrawable">@drawable/selector_rating</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:maxHeight">40dp</item>
    </style>

    <style name="style_Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/selector_btn</item>
        <item name="android:textColor">@color/selector_btn_txt</item>
        <item name="chipCornerRadius">50dp</item>
    </style>

    <style name="style_chip_text" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">@dimen/chip_text</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="style_chip_text1" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">@dimen/chip_text</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="style_Chip1" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/selector_btn</item>
        <item name="android:textColor">@color/selector_btn_txt</item>
        <item name="android:minHeight">24dp</item>
        <item name="chipCornerRadius">50dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
    </style>

    <style name="style_tv_filter_chip" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/selector_btn_txt</item>
        <item name="android:textSize">@dimen/chip_text</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="style_tv_question" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/text_Color_Primary</item>
        <item name="android:textSize">@dimen/tv_question</item>
    </style>

    <style name="style_tv_recent_search" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/lightGrey</item>
    </style>

    <style name="style_tv_sort_filter" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="style_tv_filter" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_filter</item>
    </style>

    <style name="style_tv_events" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_filter</item>
    </style>

</resources>