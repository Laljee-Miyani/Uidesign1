<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="style_button_default" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/vector_button_default</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/tv_secondary</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="style_tv_primary" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/tv_primary</item>
    </style>

    <style name="style_tv_default" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/lightGrey</item>
        <item name="android:textSize">@dimen/tv_secondary</item>
    </style>

    <style name="style_dot_indicator">
        <item name="spi_dotColor">@color/unselectedDot</item>
        <item name="spi_dotSelectedColor">@color/selectedDot</item>
        <item name="spi_dotSpacing">8dp</item>
        <item name="spi_dotSize">8dp</item>
    </style>

    <style name="style_tv_list">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">@dimen/tv_list</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
    </style>

    <style name="RadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@drawable/selector_radio_button</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="buttonTint">@color/radio_button_selector</item>
    </style>

    <style name="style_Subscription_tv_plan">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_list</item>
    </style>

    <style name="style_subscription_tv_price">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/h3</item>
    </style>

    <style name="style_Subscription_tv_plan_time">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">@dimen/tv_subscription_plan_time</item>
    </style>

    <style name="style_Subscription_tv_discount">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">@dimen/tv_subscription_plan_time</item>
    </style>

    <style name="style_interests_tv">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/tvList</item>
        <item name="android:textSize">@dimen/tv_list</item>
    </style>
</resources>